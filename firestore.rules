rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // User profiles — readable by all authenticated users (public profiles feature),
    // writable only by the profile owner.
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Gigs — readable by all authenticated users.
    // Only the church that owns the gig (church_id) can modify it.
    match /gigs/{gigId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.church_id;
      allow update, delete: if isAuth() && request.auth.uid == resource.data.church_id;
    }

    // Applications — musicians can create and read their own applications.
    // Status updates (pending → accepted/rejected) happen via Cloud Functions
    // using the admin SDK, which bypasses these rules.
    match /applications/{appId} {
      allow read: if isAuth() && request.auth.uid == resource.data.musician_id;
      allow create: if isAuth() && request.auth.uid == request.resource.data.musician_id;
      allow update, delete: if false;
    }

    // Conversations — only participants listed in the document can read or update.
    match /conversations/{convId} {
      allow read, update: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;
    }

    // Messages — any participant of the parent conversation can read messages.
    // Only the sender can create a message (sender_id must match auth uid).
    // Messages are immutable once sent.
    match /messages/{msgId} {
      allow read: if isAuth() &&
        request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(resource.data.conversation_id)
        ).data.participants;
      allow create: if isAuth() && request.auth.uid == request.resource.data.sender_id;
      allow update, delete: if false;
    }

    // Payments — owner can read their own record.
    // All writes come from Cloud Functions (admin SDK bypasses rules).
    match /payments/{paymentId} {
      allow read: if isAuth() && request.auth.uid == resource.data.user_id;
      allow write: if false;
    }
  }
}
